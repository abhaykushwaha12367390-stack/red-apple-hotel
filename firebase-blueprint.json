{
  "entities": {
    "Booking": {
      "title": "Booking",
      "description": "Hotel reservation request submitted by a guest (with masked ID verification only).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 4,
          "maxLength": 64,
          "description": "Unique booking request reference ID"
        },
        "guestName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "mobileNumber": {
          "type": "string",
          "minLength": 7,
          "maxLength": 30
        },
        "emailAddress": {
          "type": "string",
          "maxLength": 160
        },
        "roomId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 2,
          "maxLength": 64
        },
        "roomName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "checkIn": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10
        },
        "checkOut": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10
        },
        "nights": {
          "type": "number"
        },
        "estimatedAmount": {
          "type": "number"
        },
        "currencySymbol": {
          "type": "string",
          "maxLength": 6
        },
        "adults": {
          "type": "number"
        },
        "children": {
          "type": "number"
        },
        "guestsCount": {
          "type": "number"
        },
        "bookingDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "Confirmed", "Rejected", "Cancelled", "Completed"]
        },
        "specialRequests": {
          "type": "string",
          "maxLength": 1000
        },
        "arrivalWindow": {
          "type": "string",
          "maxLength": 80
        },
        "idDocumentType": {
          "type": "string",
          "maxLength": 60
        },
        "idDocumentMasked": {
          "type": "string",
          "maxLength": 40
        },
        "hasPrivateIdAttachment": {
          "type": "boolean"
        },
        "whatsappNotificationStatus": {
          "type": "string",
          "enum": ["pending", "sent", "failed", "not_configured"]
        },
        "emailNotificationStatus": {
          "type": "string",
          "enum": ["pending", "sent", "failed", "not_configured"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "guestName",
        "mobileNumber",
        "roomId",
        "roomName",
        "checkIn",
        "checkOut",
        "adults",
        "children",
        "guestsCount",
        "bookingDate",
        "status",
        "createdAt"
      ]
    },
    "Enquiry": {
      "title": "Enquiry",
      "description": "Contact or room enquiry submitted by a visitor.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 4,
          "maxLength": 64
        },
        "customerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "phoneNumber": {
          "type": "string",
          "maxLength": 40
        },
        "email": {
          "type": "string",
          "maxLength": 160
        },
        "subject": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "message": {
          "type": "string",
          "minLength": 4,
          "maxLength": 2000
        },
        "roomContext": {
          "type": "string",
          "maxLength": 120
        },
        "enquiryDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10
        },
        "status": {
          "type": "string",
          "enum": ["Unread", "Read", "Resolved"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "customerName",
        "phoneNumber",
        "email",
        "subject",
        "message",
        "enquiryDate",
        "status",
        "createdAt"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized hotel admin profile.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "maxLength": 160
        },
        "role": {
          "type": "string",
          "enum": ["owner"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "role", "createdAt"]
    }
  },
  "firestore": {
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Private guest booking requests; public creation allowed with validation, reads/updates restricted to hotel admins."
    },
    "/enquiries/{enquiryId}": {
      "schema": { "$ref": "#/entities/Enquiry" },
      "description": "Guest contact enquiries; public creation allowed with validation, reads/updates restricted to hotel admins."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Hotel owner/admin allowlist."
    }
  }
}
