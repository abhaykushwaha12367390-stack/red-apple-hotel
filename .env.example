# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------
# Automatic Booking Notifications (Server-Side Only — Never Expose)
# ------------------------------------------------------------------

# Formspree endpoint configured to deliver booking notifications to yogeshjee1987@gmail.com
FORMSPREE_ENDPOINT="https://formspree.io/f/xaeoqpbw"
OWNER_NOTIFICATION_EMAIL="yogeshjee1987@gmail.com"

# WhatsApp Business Cloud API (Meta Graph API)
# Recipient hotel owner WhatsApp number (defaults to +91 88601 51690)
OWNER_WHATSAPP_NUMBER="+91 88601 51690"
WHATSAPP_ACCESS_TOKEN="YOUR_WHATSAPP_BUSINESS_ACCESS_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="YOUR_WHATSAPP_PHONE_NUMBER_ID"
WHATSAPP_API_VERSION="v21.0"

# Optional: Approved WhatsApp message template name & language code (e.g. hello_world / en_US or booking_request_alert / en)
# If omitted, the server attempts a structured WhatsApp Business text payload.
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANGUAGE="en_US"
